VITE_FB_API_KEY=your-api-key
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project-id
VITE_FB_STORAGE_BUCKET=your-project.appspot.com
VITE_FB_MESSAGING_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000:web:abc

# PromptPay id used to build the payment QR (a phone number or national id).
VITE_PROMPTPAY_ID=0000000000

# Dashboard PIN. This is a client-side app, so this value ends up in the
# shipped bundle and is readable by anyone using the site — treat it as a
# convenience gate, not a security control. Real access control is in
# firestore.rules.
VITE_DASHBOARD_PIN=1234
